<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blume_plum_dark">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name"
            app:titleTextColor="@color/text_primary"
            app:subtitle="@string/tagline"
            app:subtitleTextColor="@color/blume_pink_light"
            app:navigationIcon="@drawable/ic_blume_logo">

            <!-- Run Button in Toolbar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:text="@string/action_run"
                android:textColor="#FFFFFF"
                app:backgroundTint="@color/blume_pink"
                app:cornerRadius="8dp" />

            <!-- Examples Picker Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExamples"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:text="@string/action_examples"
                android:textColor="@color/gc_cyan"
                app:strokeColor="@color/gc_cyan"
                app:cornerRadius="8dp" />

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Navigation Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_elevated"
            app:tabIndicatorColor="@color/blume_pink"
            app:tabSelectedTextColor="@color/blume_pink"
            app:tabTextColor="@color/text_secondary"
            app:tabMode="fixed" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
